# Copy these values into Streamlit Community Cloud > App > Settings > Secrets.
# Use Supabase project URL and service_role key. Keep the key private.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Groq API key enables AI-generated answers and question generation.
# Without it, the app still extracts and stores data and uses a basic fallback.
GROQ_API_KEY = "YOUR_GROQ_API_KEY"
GROQ_MODEL = "llama-3.3-70b-versatile"

# Strong shared password to protect your demo and private notes.
APP_PASSWORD = "CHANGE-THIS-TO-A-LONG-RANDOM-PASSWORD"
